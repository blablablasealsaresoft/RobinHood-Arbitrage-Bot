# Single-strategy Robinhood sequencer flash-arb configuration.
# Copy to .env. NEVER commit real private keys or authenticated RPC URLs.

LIVE=0

# Relayer key: signs/broadcasts the outer transaction and pays gas.
PRIVATE_KEY=0xyour_relayer_key

# Separate EIP-712 strategy signer used by SequencerFlashArbExecutorV4.
STRATEGY_PRIVATE_KEY=0xyour_strategy_signer_key

# Profit destination and eventual contract owner.
TREASURY_ADDR=
SAFE_OWNER=
RELAYER_ADDR=

# A LOCAL Robinhood Nitro RPC is mandatory for the latency path.
# The feed wins the observation race; this node provides exact executed state for block N.
LOCAL_RPC_URL=http://127.0.0.1:8547

# Deployment/admin RPC. May be a private provider.
EXEC_RPC_URL=
RPC_URL=

# Identical signed bytes are POSTed concurrently to every URL here.
# Put the official sequencer plus measured private delivery paths here.
BROADCAST_RPC_URLS=https://sequencer.mainnet.chain.robinhood.com
BROADCAST_TIMEOUT_MS=1200

# Filled by npm run deploy.
FLASH_EXECUTOR_ADDR=
CURVE_ADAPTER_ADDR=
V4_ADAPTER_ADDR=
ROUTE_QUOTER_ADDR=

# One strategy: WETH -> token -> WETH across RobinFun and Uniswap V4.
MIN_SIZE_ETH=0.002
MAX_SIZE_ETH=0.25
WETH_BORROW_CAP=0.25
GRID_POINTS=8
SLIPPAGE_BPS=50

# Aggressive expected-value gate. No arbitrary bps floor.
# 0 means use measured success gas and no assumed race-loss penalty yet.
LOSE_RACE_BPS=0
MIN_EXPECTED_VALUE_WEI=0
ONCHAIN_MIN_PROFIT_WEI=0

# Gas model/caps. Tune from actual receipts.
FLASH_GAS_UNITS=850000
REVERT_GAS_UNITS=180000
MAX_GAS_PRICE_WEI=500000000
MODEL_GAS_PRICE_WEI=500000000
MAX_PRIORITY_FEE_PER_GAS_WEI=0

# Strict next-L2-block operation.
INTENT_TTL_SECONDS=2
LOCAL_NODE_CATCHUP_MS=120
LOCAL_NODE_POLL_MS=4

# Verified direct feed process.
FEED_PYTHON=python3.11

# Non-blocking NDJSON latency/P&L telemetry.
SEQUENCER_TELEMETRY=sequencer-telemetry.ndjson

# Optional deployment override. Default is current documented Robinhood Morpho Blue.
MORPHO_ADDR=
