# Copy to .env and fill. .env is gitignored — NEVER commit real keys/RPC.

# Wallet that owns the executor + pays gas
PRIVATE_KEY=0xyour_private_key_here

# Deployed ArbExecutor address (set after `npm run deploy`)
EXECUTOR_ADDR=

# Live trading toggle (1 = trade, 0 = monitor only)
LIVE=0

# --- RPC ---
# Execution RPC. Default below = the public Robinhood RPC (works out of the box on
# a server/VPS). OPTIONAL: for more reliable execution use a private Alchemy
# endpoint — create a free app for Robinhood Chain at https://dashboard.alchemy.com
# and paste its URL here (e.g. https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY).
EXEC_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
# Monitor RPC. Leave BLANK to reuse EXEC_RPC_URL when it is configured; if both
# are blank the bot uses the public RPC with its built-in DNS-block bypass.
RPC_URL=

# --- strategy ---
WATCHLIST=1              # 1 = watch every token in watchlist.json (npm run scan)
MIN_SIZE_ETH=0.002       # optimal-size search lower bound
MAX_SIZE_ETH=0.005       # upper bound (cap capital at risk per fill)
MIN_PROFIT_BPS=150       # required net edge after fees + gas
SLIPPAGE_BPS=100
GRID_POINTS=3            # geometric probe sizes per direction
POLL_MS=45000            # fallback poll (bot is mainly event-driven)
EVENT_POLL_MS=6000       # Swap-event getLogs cadence
GAS_UNITS=700000
GAS_BUFFER_BPS=12000     # 20% fee ceiling buffer; included in on-chain profit floor
RPC_CONCURRENCY=3        # max in-flight on the fallback pinned provider

# --- incremental scanner ---
SCAN_RPC_URL=             # blank = fast pinned public RPC; keep trading RPC isolated
SCAN_BLOCK_CHUNK=1000000  # smaller if a custom scan RPC limits eth_getLogs ranges
SCAN_CONFIRMATIONS=12
SCAN_REORG_OVERLAP=64
SCAN_FROM_BLOCK=0        # optional first-scan shortcut; only if deployment block is known
SCAN_INTERVAL_MS=1800000  # PM2 scanner cadence: 30 minutes
SCAN_RETRY_MS=600000      # retry failed scheduled scan after 10 minutes
SCAN_LOCK_STALE_MS=1800000

# --- Telegram notifications (bot must be /start-ed by the recipient first) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_ALERTS=1   # every boot/poll, including idle and negative spread
TELEGRAM_SCAN_ALERTS=1   # every scheduled/manual scan, including no changes
