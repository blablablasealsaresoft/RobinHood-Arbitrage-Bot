# Robinhood sequencer flash-arb — one bot / one strategy.
# Copy to .env. Never commit real keys or authenticated RPC URLs.

LIVE=0

# Outer transaction relayer; pays gas.
PRIVATE_KEY=0xyour_relayer_private_key

# Dedicated EIP-712 strategy signer.
STRATEGY_PRIVATE_KEY=0xyour_strategy_private_key
STRATEGY_SIGNER=

# Safe/multisig controls executor + adapters. Treasury receives WETH profit.
SAFE_OWNER=
TREASURY_ADDR=

# Local Robinhood Nitro RPC is mandatory for the hot path.
LOCAL_RPC_URL=http://127.0.0.1:8547

# Deployment/admin RPC.
EXEC_RPC_URL=
RPC_URL=

# Identical raw bytes are sent concurrently to every URL.
BROADCAST_RPC_URLS=https://sequencer.mainnet.chain.robinhood.com
BROADCAST_TIMEOUT_MS=1200

# Filled after npm run deploy.
SEQUENCER_EXECUTOR_ADDR=
ROBIN_FUN_WETH_ADAPTER=
UNISWAP_V4_WETH_ADAPTER=
ROUTE_QUOTER_ADDR=

# One RobinFun <-> V4 WETH-settled strategy.
MIN_SIZE_ETH=0.002
MAX_SIZE_ETH=0.25
GRID_POINTS=8
SLIPPAGE_BPS=50

# Expected-value submission gate.
LOSE_RACE_BPS=0
MIN_EXPECTED_VALUE_WEI=0
ONCHAIN_MIN_PROFIT_WEI=0

# Gas model / hard tx ceiling.
FLASH_GAS_UNITS=850000
REVERT_GAS_UNITS=180000
MAX_GAS_PRICE_WEI=500000000
MODEL_GAS_PRICE_WEI=500000000
MAX_PRIORITY_FEE_PER_GAS_WEI=0

# Strict N -> N+1 intent lifetime.
INTENT_TTL_SECONDS=2
LOCAL_NODE_CATCHUP_MS=120
LOCAL_NODE_POLL_MS=4

# Feed + telemetry.
FEED_PYTHON=python3.11
SEQUENCER_TELEMETRY=sequencer-telemetry.ndjson

# Optional deployment override.
MORPHO_ADDR=
